<?xml version="1.0" encoding="UTF-8"?>
<!--
    Cornell box for the current camera convention:
    camera at (0, 0, 0), looking toward +Z.
    The whole scene is translated 0.2 units along +Y and 0.5 units along +Z.
-->
<scene>
    <!-- Box shell: floor, ceiling, back, left wall and right wall. -->
    <object position="0 0.2 0.5" euler="0 0 0" scale="0.6">
        <!-- Floor, y = -2.5. -->
        <triangle v0="-3 -2.5 3" v1="3 -2.5 9" v2="3 -2.5 3" />
        <triangle v0="-3 -2.5 3" v1="-3 -2.5 9" v2="3 -2.5 9" />

        <!-- Ceiling, y = 2.5. -->
        <triangle v0="-3 2.5 3" v1="3 2.5 3" v2="3 2.5 9" />
        <triangle v0="-3 2.5 3" v1="3 2.5 9" v2="-3 2.5 9" />

        <!-- Back wall, z = 9. -->
        <triangle v0="-3 -2.5 9" v1="3 2.5 9" v2="3 -2.5 9" />
        <triangle v0="-3 -2.5 9" v1="-3 2.5 9" v2="3 2.5 9" />

        <!-- Left wall, x = -3. -->
        <triangle v0="-3 -2.5 3" v1="-3 2.5 9" v2="-3 -2.5 9" />
        <triangle v0="-3 -2.5 3" v1="-3 2.5 3" v2="-3 2.5 9" />

        <!-- Right wall, x = 3. -->
        <triangle v0="3 -2.5 3" v1="3 -2.5 9" v2="3 2.5 9" />
        <triangle v0="3 -2.5 3" v1="3 2.5 9" v2="3 2.5 3" />
    </object>

    <!-- Visible test objects inside the box. -->
    <object position="-0.8 -0.7 4.0" euler="0 0 0" scale="1">
        <sphere radius="0.45" />
    </object>
    <object position="0.8 -0.4 4.6" euler="0 0 0" scale="1">
        <sphere radius="0.55" />
    </object>
</scene>
