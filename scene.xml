<?xml version="1.0" encoding="UTF-8"?>
<!-- Scene objects use world-space position/euler/scale and local-space primitives. -->
<scene>
    <object position="0 0 3" euler="0 0 0" scale="1">
        <sphere radius="0.7" />
    </object>
    <object position="1.55 0 3" euler="0 0 0" scale="1">
        <disk radius="0.7" />
    </object>
    <object position="-1.55 0 3" euler="0 0 0" scale="1">
        <triangle v0="-0.7 -0.7 0" v1="0.7 -0.7 0" v2="0 0.7 0" />
    </object>
</scene>
